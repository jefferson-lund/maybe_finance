<%# locals: (account:, size: "md", color: nil) %>

<% size_classes = {
  "sm" => "w-6 h-6",
  "md" => "w-9 h-9",
  "lg" => "w-10 h-10",
  "full" => "w-full h-full"
} %>

<% if account.plaid_account&.plaid_item&.logo&.attached? %>
  <%= image_tag account.plaid_account.plaid_item.logo, class: "shrink-0 rounded-full #{size_classes[size]}" %>
<% elsif account.institution_domain.present? %>
  <%= image_tag "https://www.google.com/s2/favicons?domain=#{url_encode(account.institution_domain)}&sz=128",
                class: "shrink-0 rounded-full #{size_classes[size]}",
                loading: "lazy" %>
<% elsif account.logo.attached? %>
  <%= image_tag account.logo, class: "shrink-0 rounded-full #{size_classes[size]}" %>
<% else %>
  <%= render DS::FilledIcon.new(variant: :text, hex_color: color || account.accountable.color, text: account.name, size: size, rounded: true) %>
<% end %>
