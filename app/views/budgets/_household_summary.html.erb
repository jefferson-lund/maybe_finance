<%# locals: (budget:) %>

<section class="space-y-4 mb-6">
  <div class="grid gap-3 sm:grid-cols-3">
    <div class="rounded-xl bg-container p-4 shadow-border-xs">
      <p class="text-sm text-secondary">Income</p>
      <p class="mt-1 text-2xl font-medium text-primary"><%= format_money(budget.actual_income_money) %></p>
    </div>
    <div class="rounded-xl bg-container p-4 shadow-border-xs">
      <p class="text-sm text-secondary">Expenses</p>
      <p class="mt-1 text-2xl font-medium text-primary"><%= format_money(budget.actual_spending_money) %></p>
    </div>
    <div class="rounded-xl bg-container p-4 shadow-border-xs">
      <p class="text-sm text-secondary">Residual savings</p>
      <p class="mt-1 text-2xl font-medium <%= budget.residual_savings.negative? ? "text-destructive" : "text-primary" %>">
        <%= format_money(budget.residual_savings_money) %>
      </p>
      <p class="mt-1 text-xs text-secondary">Income minus all expenses</p>
    </div>
  </div>

  <div class="rounded-xl bg-container p-4 shadow-border-xs">
    <div class="mb-4">
      <h2 class="text-lg font-medium text-primary">50 / 30 / 20</h2>
      <p class="text-sm text-secondary">Actual household spending compared with your income-based targets.</p>
    </div>

    <% buckets = [
      { name: "Needs", target_percent: 50, actual: budget.needs_spending, actual_money: budget.needs_spending_money, target_money: budget.needs_target_money, percent: budget.needs_percent, bar: "bg-blue-500" },
      { name: "Wants", target_percent: 30, actual: budget.wants_spending, actual_money: budget.wants_spending_money, target_money: budget.wants_target_money, percent: budget.wants_percent, bar: "bg-pink-500" },
      { name: "Savings", target_percent: 20, actual: budget.residual_savings, actual_money: budget.residual_savings_money, target_money: budget.savings_target_money, percent: budget.savings_percent, bar: "bg-green-500" }
    ] %>

    <div class="grid gap-4 lg:grid-cols-3">
      <% buckets.each do |bucket| %>
        <% bar_width = [[bucket[:percent] || 0, 0].max, 100].min %>
        <article class="rounded-lg border border-secondary p-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-medium text-primary"><%= bucket[:name] %></h3>
              <p class="text-xs text-secondary">Target <%= bucket[:target_percent] %>% · <%= format_money(bucket[:target_money]) %></p>
            </div>
            <p class="text-sm font-medium text-primary">
              <%= bucket[:percent] ? number_to_percentage(bucket[:percent], precision: 1) : "—" %>
            </p>
          </div>
          <div class="my-3 h-2 overflow-hidden rounded-full bg-surface-inset">
            <div class="h-full rounded-full <%= bucket[:bar] %>" style="width: <%= bar_width %>%"></div>
          </div>
          <p class="text-lg font-medium <%= bucket[:actual].negative? ? "text-destructive" : "text-primary" %>">
            <%= format_money(bucket[:actual_money]) %>
          </p>
        </article>
      <% end %>
    </div>

    <% if budget.unassigned_spending.positive? %>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-lg bg-container-inset p-3">
        <p class="text-sm text-secondary">
          <span class="font-medium text-primary"><%= format_money(budget.unassigned_spending_money) %></span>
          is unassigned and is not included in Needs or Wants.
        </p>
        <%= render DS::Link.new(
          text: "Categorize transactions",
          variant: "outline",
          href: transactions_path(q: {
            categories: ["Uncategorized"],
            start_date: budget.start_date,
            end_date: budget.end_date
          })
        ) %>
      </div>
    <% end %>
  </div>
</section>
